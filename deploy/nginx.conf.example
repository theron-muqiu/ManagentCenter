# 部署前替换域名、证书路径、静态目录和后端地址；在 http 块内 include。
# 访问日志只写 URI 路径，不写查询串、Authorization、请求体或 Referer。
log_format rbac_safe '$remote_addr $request_method $uri $status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name admin.example.com;
    return 301 https://admin.example.com$uri;
}
server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/managent-center/frontend;
    index index.html;
    access_log /var/log/nginx/rbac-access.log rbac_safe;
    # 错误日志可能包含请求原文，关闭独立请求级错误日志；通过访问状态/应用告警排障。
    error_log /dev/null crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    client_max_body_size 1m;
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        # 本例只有一层可信代理，覆盖客户端伪造的来源头。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_hide_header Set-Cookie;
    }
    location / { try_files $uri $uri/ /index.html; }
}
